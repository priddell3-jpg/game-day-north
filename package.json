{
  "name": "game-day-north",
  "version": "1.0.0",
  "private": true,
  "description": "Game Day North web app and bundled Capacitor iOS shell",
  "scripts": {
    "build": "node build.js && node scripts/build-web.mjs",
    "build:ios": "node build.js && node scripts/build-ios.mjs",
    "test": "node --test tests/*.test.mjs",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
